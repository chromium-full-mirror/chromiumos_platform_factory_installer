BASEDIR="$(dirname $0)"

case "${1}" in
  show )
    cat "${BASEDIR}/data/show"
    ;;
  dump_fmap )
    cat "${BASEDIR}/data/dump_fmap"
    ;;
  * )
    exit 1
    ;;
esac
