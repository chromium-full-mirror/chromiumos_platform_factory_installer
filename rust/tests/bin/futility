# found in the LICENSE file.

BASEDIR="$(dirname "$0")"

case "${1}" in
  show )
    cat "${BASEDIR}/data/show"
    ;;
  read )
    if [ "$#" -eq 2 ]; then
      echo "Dumping bios..."
    fi
    if [ "${2}" = "--region" ]; then
        echo "Dumping firmware region ${3}..."
    fi
    ;;
  * )
    exit 1
    ;;
esac
